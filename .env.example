# =====================================================
# STEP 1: Copy this file and rename it to just: .env
# STEP 2: Fill in the values below
# STEP 3: Never commit the .env file! (it's in .gitignore)
# =====================================================

# Your Minds Builder API Key
# Get this from: https://build.hellominds.ai/console
# Click "API Keys" → "Create Key" → copy it here
MINDS_BUILDER_API_KEY=paste_your_key_here

# The port your backend server runs on (leave as 3001)
SERVER_PORT=3001
